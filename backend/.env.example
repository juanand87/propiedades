PROJECT_ID=propiedades
NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=propiedades
DB_USERNAME=CHANGE_ME
DB_PASSWORD=
# Shared DigitalOcean server: set these explicitly to the same host and exclusive user.
DB_SHARED_HOST=
DB_SHARED_USERNAME=
DB_SSL=false
# Paste the server CA PEM (actual newlines or escaped \n); required when DB_SSL=true.
DB_SSL_CA=
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRATION=7d
BACKEND_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTEGRATIONS_ENABLED=false
SCHEDULED_JOBS_ENABLED=false
ADMIN_RECOVERY_ENABLED=false
UPLOAD_DIR=./uploads-propiedades
SPACES_BUCKET=
SPACES_ENDPOINT=
SPACES_CDN_URL=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
