PROJECT_ID=propiedades
NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=propiedades
DB_USERNAME=CHANGE_ME
DB_PASSWORD=
# Shared DigitalOcean server: set these explicitly to the same host and exclusive user.
DB_SHARED_HOST=
DB_SHARED_USERNAME=
DB_SSL=false
# Paste the server CA PEM (actual newlines or escaped \n); required when DB_SSL=true.
DB_SSL_CA=
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
BACKEND_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTEGRATIONS_ENABLED=false
SCHEDULED_JOBS_ENABLED=false
ADMIN_RECOVERY_ENABLED=false

# Optional image storage. Explicit opt-in; no automatic migration of existing blobs.
SPACES_IMAGES_ENABLED=false
SPACES_BUCKET=propiedades-imagenes
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Development uses this isolated prefix. Production uses propiedades/imagenes.
SPACES_IMAGES_PREFIX=propiedades/pruebas/imagenes

# Video feature is disabled until its SQL migration and Spaces config are ready.
PROPERTY_VIDEOS_ENABLED=false
SPACES_VIDEOS_ENABLED=false
USER_ONBOARDING_ENABLED=false
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPACES_VIDEOS_PREFIX=propiedades/pruebas/videos
