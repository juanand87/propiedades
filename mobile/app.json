{
  "expo": {
    "name": "Proppix",
    "slug": "proppix",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06272d",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cl.proppix.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Seleccionar videos para vincularlos a tus propiedades.",
          "cameraPermission": "Permite la cámara para grabar recorridos de tus propiedades.",
          "microphonePermission": "Permite el micrófono para añadir sonido al recorrido."
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite la cámara para grabar recorridos de tus propiedades.",
          "microphonePermission": "Permite el micrófono para añadir sonido al recorrido.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "proppix",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99edd5e4-9757-4012-b924-16cb6f56f84b"
      }
    }
  }
}
