{
  "expo": {
    "name": "Proppix",
    "slug": "proppix",
    "version": "1.0.41",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cl.proppix.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "versionCode": 42
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f7ff",
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#f5f7ff",
            "image": "./assets/splash-logo.png"
          }
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Seleccionar fotos para mensajes y fotos o videos para tus propiedades.",
          "cameraPermission": "Permite la cámara para grabar recorridos de tus propiedades.",
          "microphonePermission": "Permite el micrófono para añadir sonido al recorrido."
        }
      ],
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite la cámara para grabar recorridos de tus propiedades.",
          "microphonePermission": "Permite el micrófono para añadir sonido al recorrido.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permite el micrófono para dictar las características de una propiedad.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "proppix",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99edd5e4-9757-4012-b924-16cb6f56f84b"
      }
    }
  }
}
